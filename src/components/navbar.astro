<style>
  #mobileMenu {
    clip-path: circle(0% at 90% 5%);
    transition: clip-path 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    pointer-events: none;
  }
  #mobileMenu.is-open {
    clip-path: circle(150% at 90% 5%);
    pointer-events: auto;
  }
</style>

<!-- Nav Wrapper -->
<div id="navWrapper" class="fixed inset-x-0 z-[9999] flex justify-center pointer-events-none transition-all duration-500" style="top: 16px;">
  <div id="navContainer" class="pointer-events-auto transition-all duration-500 w-[94%] max-w-6xl bg-zinc-900/80 backdrop-blur-2xl border border-white/10 rounded-full shadow-2xl px-4 sm:px-6">
    <div class="flex justify-between items-center h-14">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group shrink-0 z-[10001]">
        <img class="w-8 h-8 transition-transform duration-300 group-hover:scale-110" src="/images/Allied-Algorithms_logo.svg" alt="Logo">
        <span id="brandName" class="flex items-baseline gap-2 text-lg font-bold text-white transition-all duration-500 overflow-hidden whitespace-nowrap">
          Allied Algorithms
          <span class="font-mono text-[10px] font-medium text-accent/90">600757</span>
        </span>
      </a>

      <!-- Hamburger (mobile) -->
      <button id="mobileMenuBtn" aria-label="Toggle menu" class="md:hidden flex flex-col justify-center items-center gap-[5px] w-10 h-10 rounded-full bg-white/5 border border-white/10 p-2 z-[10001] outline-none hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 transition-colors">
        <span id="ham1" class="w-5 h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
        <span id="ham2" class="w-5 h-0.5 bg-white rounded-full transition-all duration-300"></span>
        <span id="ham3" class="w-3.5 h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
      </button>

      <!-- Desktop Nav -->
      <ul class="hidden md:flex gap-1 items-center shrink-0">
        <li>
          <a href="/about-us" class="text-zinc-400 hover:text-white text-sm font-medium px-4 py-2 rounded-full hover:bg-white/5 transition-all">About Us</a>
        </li>
        <li>
          <a href="/seasons" class="text-zinc-400 hover:text-white text-sm font-medium px-4 py-2 rounded-full hover:bg-white/5 transition-all">Seasons</a>
        </li>
        <li class="relative" id="projectsMenuItem">
          <button id="projectsBtn" class="text-zinc-400 hover:text-white text-sm font-medium px-4 py-2 rounded-full hover:bg-white/5 flex items-center gap-1.5 outline-none transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            Projects <i id="projectsChevron" class="fa-solid fa-chevron-down text-[9px] opacity-60 transition-transform duration-300"></i>
          </button>
        </li>
        <li class="ml-2">
          <a href="/contact-us" class="px-5 py-2.5 text-white text-[11px] font-mono font-semibold uppercase tracking-wider rounded-full bg-blue-600 hover:bg-blue-500 active:scale-95 transition-all shadow-lg shadow-blue-600/20">
            Contact
          </a>
        </li>
      </ul>

    </div>
  </div>
</div>

<!-- Projects Dropdown -->
<div id="projectDropdown" class="fixed opacity-0 invisible translate-y-2 z-[9998] bg-zinc-950/95 backdrop-blur-3xl border border-white/10 shadow-2xl transition-all duration-300 rounded-3xl overflow-hidden">
  <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-blue-500/40 pointer-events-none"></span>
  <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-blue-500/40 pointer-events-none"></span>
  <div class="p-4 sm:p-6">
    <p class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 mb-3 px-2">// Projects</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <a href="/robot" class="group flex items-start gap-3.5 p-3.5 rounded-2xl border border-transparent hover:bg-white/5 hover:border-white/10 transition-all">
        <div class="w-8 h-8 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center shrink-0 group-hover:bg-blue-500/20 transition-colors">
          <i class="fa-solid fa-robot text-blue-400 text-xs"></i>
        </div>
        <div>
          <div class="text-sm font-semibold text-white mb-0.5">Robot Designs</div>
          <p class="text-xs text-zinc-400 leading-relaxed">CAD designs and build instructions</p>
        </div>
      </a>
    </div>
  </div>
</div>

<!-- Mobile Menu Overlay -->
<div id="mobileMenu" class="fixed inset-2 z-[10000] bg-zinc-950/98 backdrop-blur-3xl rounded-[2.5rem] border border-white/10 flex flex-col p-8 pt-28 md:hidden shadow-2xl">
  <nav class="flex flex-col gap-6 text-center my-auto">
    <a href="/about-us" class="group flex items-center justify-center gap-3 text-3xl font-bold tracking-tight text-white hover:text-blue-400 transition-colors">
      <span class="font-mono text-xs text-zinc-600 group-hover:text-accent transition-colors">01</span>About Us
    </a>
    <a href="/seasons" class="group flex items-center justify-center gap-3 text-3xl font-bold tracking-tight text-white hover:text-blue-400 transition-colors">
      <span class="font-mono text-xs text-zinc-600 group-hover:text-accent transition-colors">02</span>Seasons
    </a>
    <a href="/robot" class="group flex items-center justify-center gap-3 text-3xl font-bold tracking-tight text-white hover:text-blue-400 transition-colors">
      <span class="font-mono text-xs text-zinc-600 group-hover:text-accent transition-colors">03</span>Robot
    </a>
    <div class="h-px bg-white/10 w-24 mx-auto my-2"></div>
    <a href="/contact" class="py-4 rounded-full text-white font-mono font-semibold uppercase tracking-widest text-sm bg-blue-600 hover:bg-blue-500 transition-all shadow-lg shadow-blue-600/30">
      Contact
    </a>
  </nav>
</div>

<script>
(function () {
  const navWrapper       = document.getElementById('navWrapper');
  const navContainer     = document.getElementById('navContainer');
  const brandName        = document.getElementById('brandName');
  const mobileMenuBtn    = document.getElementById('mobileMenuBtn');
  const mobileMenu       = document.getElementById('mobileMenu');
  const projectsMenuItem = document.getElementById('projectsMenuItem');
  const projectsChevron  = document.getElementById('projectsChevron');
  const projectDropdown  = document.getElementById('projectDropdown');
  const ham1 = document.getElementById('ham1');
  const ham2 = document.getElementById('ham2');
  const ham3 = document.getElementById('ham3');

  let menuOpen = false;
  let dropTimer = null;

  // --- Dropdown Positioning ---
  function positionDropdown() {
    const r = navContainer.getBoundingClientRect();
    projectDropdown.style.top   = (r.bottom + 10) + 'px';
    projectDropdown.style.left  = r.left + 'px';
    projectDropdown.style.width = r.width + 'px';
  }

  function openDropdown() {
    clearTimeout(dropTimer);
    positionDropdown();
    projectDropdown.classList.remove('opacity-0', 'invisible', 'translate-y-2');
    projectDropdown.classList.add('opacity-100', 'visible', 'translate-y-0');
    projectsChevron.style.transform = 'rotate(180deg)';
  }

  function closeDropdown() {
    dropTimer = setTimeout(() => {
      projectDropdown.classList.add('opacity-0', 'invisible', 'translate-y-2');
      projectDropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
      projectsChevron.style.transform = '';
    }, 150);
  }

  projectsMenuItem.addEventListener('mouseenter', openDropdown);
  projectsMenuItem.addEventListener('mouseleave', closeDropdown);
  projectDropdown.addEventListener('mouseenter', () => clearTimeout(dropTimer));
  projectDropdown.addEventListener('mouseleave', closeDropdown);

  // --- Mobile Menu Toggle ---
  mobileMenuBtn.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu.classList.toggle('is-open', menuOpen);
    ham1.style.transform = menuOpen ? 'rotate(45deg) translate(4px, 4px)' : '';
    ham2.style.opacity   = menuOpen ? '0' : '1';
    ham3.style.transform = menuOpen ? 'rotate(-45deg) translate(4px, -4px)' : '';
    ham3.style.width     = menuOpen ? '20px' : '14px';
    document.body.style.overflow = menuOpen ? 'hidden' : '';
  });

  // --- Dynamic Nav Scroll State ---
  function applyNavState() {
    const scrolled = window.scrollY > 20;
    const isMobile = window.innerWidth < 768;

    if (isMobile || !scrolled) {
      navWrapper.style.top = '16px';
      navContainer.className = 'pointer-events-auto transition-all duration-500 w-[94%] max-w-6xl bg-zinc-900/80 backdrop-blur-2xl border border-white/10 rounded-full shadow-2xl px-4 sm:px-6';
      navContainer.style.width = '';
      brandName.classList.remove('max-w-0', 'opacity-0');
    } else {
      // Ultra-compact pill on scroll
      navWrapper.style.top = '12px';
      navContainer.className = 'pointer-events-auto transition-all duration-500 rounded-full bg-zinc-950/90 backdrop-blur-2xl border border-white/15 shadow-2xl px-5';
      navContainer.style.width = 'fit-content';
      brandName.classList.add('max-w-0', 'opacity-0');
    }

    if (!projectDropdown.classList.contains('invisible')) positionDropdown();
  }

  window.addEventListener('scroll', applyNavState, { passive: true });
  window.addEventListener('resize', applyNavState);
  applyNavState();
})();
</script>
