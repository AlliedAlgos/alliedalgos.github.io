---
import Layout from '../../layouts/Layout.astro';
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';

// Read and parse TOML data from ../../data/seasons.toml
const seasonsPath = new URL('../../data/seasons.toml', import.meta.url);
const seasonsRaw = readFileSync(seasonsPath, 'utf-8');
const { seasons } = parse(seasonsRaw) as { seasons: any[] };

const currentSeason = seasons.find((s) => s.is_current);
const otherSeasons = seasons.filter((s) => !s.is_current);

// Real chronological index (season 01 = our first year, oldest-first).
const seasonNumber = (season: any) => seasons.length - seasons.indexOf(season);

const title = "Seasons | Allied Algorithms";
---

<Layout title={title}>
  <main class="font-mono relative min-h-screen pt-32 pb-40 overflow-hidden">

    <!-- Blueprint Grid Background Texture -->
    <div class="absolute inset-0 bg-blueprint-grid opacity-20 [mask-image:linear-gradient(to_bottom,black,transparent_70%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10 font-mono">

      <!-- Header -->
      <header class="mb-32 max-w-3xl">
        <p class="font-mono text-xs text-blue-400 uppercase tracking-widest mb-6">Competition Log &middot; 2020&ndash;2026</p>
        <h1 class="font-mono text-7xl md:text-[10rem] font-black italic text-white uppercase tracking-tighter leading-[0.75]">
          Our <span class="text-blue-300/50">Journey.</span>
        </h1>
        <p class="mt-8 font-mono text-sm text-slate-100 leading-relaxed max-w-xl">
          Six seasons of builds, missions, and competition results
        </p>
      </header>

      <!-- Current Season Section -->
      {currentSeason && (
        <section class="mb-48">
          <div class="relative">
            <div class="relative z-10 aspect-[16/8] rounded-3xl overflow-hidden border border-white/20 shadow-xl">
              <img src={currentSeason.cover_photo} alt={currentSeason.theme} class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#030712] via-transparent to-transparent"></div>
            </div>

            <div class="relative z-20 -mt-32 ml-auto max-w-2xl p-12 lg:p-16 bg-[#0a0f1a] border border-white/10 rounded-3xl mr-8 lg:mr-16">
              <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-blue-500/40"></span>
              <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-blue-500/40"></span>

              <div class="flex flex-wrap items-center gap-4 mb-6 font-mono text-xs uppercase tracking-widest">
                <span class="text-accent">// Current Season</span>
                <span class="text-white/40">{currentSeason.year}</span>
                <span class="text-white/20">Season {String(seasonNumber(currentSeason)).padStart(2, '0')}</span>
              </div>

              <h2 class="font-mono text-5xl lg:text-7xl font-bold text-white uppercase tracking-tight mb-4 leading-none">
                {currentSeason.theme}
              </h2>

              <p class="font-mono text-xs text-blue-400 uppercase tracking-widest mb-6">
                "{currentSeason.tagline}"
              </p>

              <p class="font-mono text-slate-300 text-base leading-relaxed mb-8">
                {currentSeason.robot_description}
              </p>

              {currentSeason.awards && currentSeason.awards.length > 0 && (
                <div class="flex flex-wrap gap-x-6 gap-y-2 pt-6 mb-8 border-t border-white/10 font-mono text-xs text-blue-300 uppercase tracking-wide">
                  {currentSeason.awards.map((award: string) => (
                    <span class="flex items-center gap-2"><span class="text-blue-500">&mdash;</span>{award}</span>
                  ))}
                </div>
              )}

              <!-- Slug Action Link -->
              <a
                href={`/seasons/${currentSeason.slug}`}
                class="inline-flex items-center gap-3 px-6 py-3 bg-blue-600/20 border border-blue-500/40 text-blue-300 font-mono text-xs uppercase tracking-wider rounded-xl hover:bg-blue-600 hover:text-white transition-all group"
              >
                View Full Season Specs
                <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
              </a>
            </div>
          </div>
        </section>
      )}

      <!-- Technical Lineage Grid -->
      <section>
        <div class="flex items-center gap-6 mb-16 px-4">
          <h3 class="font-mono text-xs text-blue-400 uppercase tracking-widest">Technical Lineage</h3>
          <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {otherSeasons.map((season) => (
            <div class="relative flex flex-col bg-white/[0.02] border border-white/5 rounded-2xl transition-all duration-300 hover:border-white/20 group">

              <div class="aspect-[16/10] overflow-hidden rounded-t-2xl relative">
                <img src={season.cover_photo} alt={season.theme} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#030712]/60 to-transparent"></div>
              </div>

              <div class="p-10 lg:p-12 font-mono flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex justify-between items-center mb-6 font-mono text-xs text-slate-500 uppercase tracking-widest">
                    <span>Season {String(seasonNumber(season)).padStart(2, '0')}</span>
                    <span>{season.year}</span>
                  </div>

                  <h4 class="font-mono text-3xl lg:text-4xl font-bold text-white uppercase tracking-tight mb-2 leading-none">
                    {season.theme}
                  </h4>

                  <p class="font-mono text-xs text-blue-400 uppercase tracking-widest mb-6">
                    "{season.tagline}"
                  </p>

                  <p class="font-mono text-slate-400 text-sm leading-relaxed mb-8">
                    {season.robot_description}
                  </p>
                </div>

                <div>
                  {season.awards && season.awards.length > 0 && (
                    <div class="flex flex-wrap gap-x-6 gap-y-2 pt-6 mb-8 border-t border-white/5 font-mono text-xs text-blue-300 uppercase tracking-wide">
                      {season.awards.map((award: string) => (
                        <span class="flex items-center gap-2"><span class="text-blue-500">&mdash;</span>{award}</span>
                      ))}
                    </div>
                  )}

                  <!-- Slug Action Link -->
                  <a
                    href={`/seasons/${season.slug}`}
                    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-slate-400 hover:text-blue-400 transition-colors"
                  >
                    Explore Season Archive <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>

              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </main>
</Layout>
