---
import Layout from '../../layouts/Layout.astro';
import { parse } from 'smol-toml';
import seasonsRaw from '../../data/seasons.toml?raw';

const { seasons } = parse(seasonsRaw) as { seasons: any[] };

// Chronological order: Oldest season at the top, newest/current at the bottom
const sortedSeasons = [...seasons];
const seasonNumber = (season: any) => seasons.indexOf(season) + 1;

const title = "Seasons | Allied Algorithms";
---
<Layout title={title}>
  <main class="font-mono relative w-full h-screen overflow-hidden bg-[#60a5fa] text-white">

    <!-- Blueprint Grid Background Texture -->
    <div class="absolute inset-0 bg-blueprint-grid opacity-10 pointer-events-none z-0"></div>

    <!-- Top Fixed Header -->
    <header class="absolute top-6 left-6 md:left-12 z-30 pointer-events-none">
      <p class="text-[10px] md:text-xs text-blue-100 uppercase tracking-widest mb-1">Competition Log &middot; 2020&ndash;2026</p>
      <h1 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-white">
        Our <span class="text-blue-100/70">Journey</span>
      </h1>
    </header>

    <!-- Right-Side Vertical Scroll Indicator Dots with Up/Down Arrows -->
    <nav aria-label="Season Navigation" class="absolute right-6 md:right-10 top-1/2 -translate-y-1/2 z-30 hidden sm:flex flex-col items-center gap-2 bg-blue-950/50 p-2.5 rounded-2xl border border-white/20 backdrop-blur-md shadow-2xl">
      <!-- Up Arrow Button -->
      <button
        id="dot-prev-btn"
        aria-label="Previous Season"
        class="w-7 h-7 rounded-xl bg-blue-600/70 border border-white/20 flex items-center justify-center text-white hover:bg-blue-700 transition-all cursor-pointer shadow-md text-xs"
      >
        <i class="fa-solid fa-chevron-up"></i>
      </button>

      <!-- Dots Container -->
      <div class="flex flex-col items-center gap-2.5 py-2">
        {sortedSeasons.map((season, index) => (
          <button
            data-index={index}
            aria-label={`Jump to season ${season.theme}`}
            class={`season-dot transition-all duration-300 rounded-full border border-white/40 cursor-pointer ${
              index === 0
                ? 'w-3 h-8 bg-white shadow-md'
                : 'w-3 h-3 bg-white/40 hover:bg-white/70'
            }`}
          ></button>
        ))}
      </div>

      <!-- Down Arrow Button -->
      <button
        id="dot-next-btn"
        aria-label="Next Season"
        class="w-7 h-7 rounded-xl bg-blue-600/70 border border-white/20 flex items-center justify-center text-white hover:bg-blue-700 transition-all cursor-pointer shadow-md text-xs"
      >
        <i class="fa-solid fa-chevron-down"></i>
      </button>
    </nav>

    <!-- Vertical Snap Container with Added Top Padding -->
    <div
      id="carousel-container"
      class="w-full h-full flex flex-col overflow-y-auto snap-y snap-mandatory scrollbar-none scroll-smooth items-center px-6 md:px-12 pt-36 md:pt-40 pb-20 gap-16"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {sortedSeasons.map((season) => (
        <section
          class="season-slide flex-shrink-0 w-[92vw] md:w-[82vw] lg:w-[72vw] h-[75vh] snap-center relative rounded-[2.5rem] border border-white/25 shadow-2xl overflow-hidden flex flex-col justify-between p-6 md:p-12 bg-blue-900"
        >
          <!-- Full Screen Cover Photo Background -->
          <div class="absolute inset-0 z-0 opacity-55">
            <img src={season.cover_photo} alt={season.theme} class="w-full h-full object-cover object-center" />
            <div class="absolute inset-0 bg-gradient-to-t from-blue-950 via-blue-950/40 to-transparent"></div>
          </div>

          <!-- Top Badge & Info -->
          <div class="relative z-10 flex justify-between items-start">
            <div>
              <span class="text-[10px] md:text-xs uppercase tracking-widest text-blue-200 block mb-1 font-semibold">
                {season.is_current ? '// Current Season' : `Season ${String(seasonNumber(season)).padStart(2, '0')}`}
              </span>
              <h2 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight text-white leading-none drop-shadow-md">
                {season.theme}
              </h2>
            </div>
            <span class="text-xs md:text-sm font-bold px-3.5 py-1.5 rounded-full bg-blue-950/80 border border-white/25 text-white shadow-lg backdrop-blur-md">
              {season.year}
            </span>
          </div>

          <!-- Middle Content (Robot Description & Awards) -->
          <div class="relative z-10 my-auto max-w-2xl bg-blue-950/60 backdrop-blur-md p-6 md:p-8 rounded-2xl border border-white/15 shadow-xl">
            <p class="text-xs md:text-sm text-blue-200 uppercase tracking-widest mb-3 font-semibold">
              &ldquo;{season.tagline}&rdquo;
            </p>
            <p class="text-white text-sm md:text-base leading-relaxed font-light mb-6">
              {season.robot_description}
            </p>

            {season.awards && season.awards.length > 0 && (
              <div class="pt-4 border-t border-white/20">
                <span class="text-[10px] uppercase tracking-widest text-blue-300 font-bold block mb-2">Awards & Recognition</span>
                <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-white uppercase tracking-wide">
                  {season.awards.map((award: string) => (
                    <span class="flex items-center gap-2 font-semibold"><span class="text-blue-400">&mdash;</span>{award}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Bottom Footer Details -->
          <div class="relative z-10 flex items-center justify-between text-xs text-blue-100 uppercase tracking-wider border-t border-white/20 pt-4 bg-blue-950/40 px-4 py-2 rounded-xl backdrop-blur-sm">
            <span>Team 600757 Archive</span>
            <span>Wilton, CT</span>
          </div>
        </section>
      ))}
    </div>

  </main>
</Layout>

<script is:inline>
  const container = document.getElementById('carousel-container');
  const slides = document.querySelectorAll('.season-slide');
  const dots = document.querySelectorAll('.season-dot');
  const dotPrevBtn = document.getElementById('dot-prev-btn');
  const dotNextBtn = document.getElementById('dot-next-btn');

  function updateDots() {
    if (!container) return;
    const scrollTop = container.scrollTop;
    const slideHeight = slides[0]?.offsetHeight + 64 || container.offsetHeight;
    const index = Math.round(scrollTop / slideHeight);

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('w-3', 'h-3', 'bg-white/40');
        dot.classList.add('w-3', 'h-8', 'bg-white', 'shadow-md');
      } else {
        dot.classList.remove('h-8', 'bg-white', 'shadow-md');
        dot.classList.add('w-3', 'h-3', 'bg-white/40');
      }
    });
  }

  container?.addEventListener('scroll', () => {
    window.requestAnimationFrame(updateDots);
  }, { passive: true });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      const targetSlide = slides[i];
      if (targetSlide) {
        targetSlide.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  dotPrevBtn?.addEventListener('click', () => {
    const slideHeight = slides[0]?.offsetHeight + 64 || 400;
    container.scrollBy({ top: -slideHeight, behavior: 'smooth' });
  });

  dotNextBtn?.addEventListener('click', () => {
    const slideHeight = slides[0]?.offsetHeight + 64 || 400;
    container.scrollBy({ top: slideHeight, behavior: 'smooth' });
  });
</script>
