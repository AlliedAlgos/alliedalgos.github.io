---
import Layout from '../layouts/Layout.astro'; // Use the standard name for consistency
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';

// Data fetching
const raw = readFileSync('./src/data/members.toml', 'utf-8');
const { members } = parse(raw);

// SEO Strategy: Focus on the "Brains" behind the algorithms
const title = "Our Team | Allied Algorithms FLL 58590";
const description = "Meet the engineers, designers, and strategists of Allied Algorithms. Discover the minds driving our technical excellence in FLL robotics.";
---

<Layout title={title} description={description}>

    <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {members.map((member, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "item": {
              "@type": "Person",
              "name": member.name,
              "jobTitle": member.role,
              "image": `https://alliedalgos.org${member.photo}`
            }
          }))}
        ]
      }
    }
    </script>

    <section class="relative pt-32 pb-24 overflow-hidden">
        <div class="absolute inset-0 bg-blueprint-grid opacity-30" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/0 via-zinc-950/70 to-zinc-950" aria-hidden="true"></div>

        <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
            <p class="font-mono text-xs uppercase tracking-widest text-blue-400 mb-6">Team 58590 &mdash; Wilton, CT</p>
            <h1 class="text-6xl md:text-8xl font-black tracking-tighter italic text-white leading-none mb-6 uppercase">
                WE ARE <br /><span class="text-accent">ALLIED.</span>
            </h1>
            <p class="text-zinc-500 text-lg max-w-md mx-auto leading-relaxed">
                The student engineers, coaches, and mentors who design, build, and code our FIRST LEGO League robot &mdash; and publish the CAD and software behind it.
            </p>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 mb-32">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {members.map((member) => (
                <div class="bg-zinc-900/60 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-colors">

                    <div class="aspect-[4/3] overflow-hidden bg-zinc-900">
                        <img
                            src={member.photo}
                            alt={`Portrait of ${member.name}, ${member.role} at Allied Algorithms`}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover"
                        />
                    </div>

                    <div class="p-6">
                        <p class="font-mono text-xs uppercase tracking-wide text-blue-400 mb-1">
                            {member.role}
                        </p>
                        <h2 class="text-2xl font-bold text-white mb-3">
                            {member.name}
                        </h2>
                        <p class="text-sm text-zinc-400 leading-relaxed">
                            {member.bio}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 mb-32">
        <div class="relative bg-zinc-900 border border-white/10 rounded-3xl p-10 md:p-20 text-center">
            <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-blue-500/40" aria-hidden="true"></span>
            <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-blue-500/40" aria-hidden="true"></span>

            <p class="font-mono text-xs uppercase tracking-widest text-blue-400 mb-4">Get Involved</p>
            <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
                Ready to build with us?
            </h2>

            <p class="text-zinc-500 text-lg mb-10 max-w-xl mx-auto">
                Whether you're a mentor, a potential sponsor, or a fellow builder&mdash;we'd love to have you join the alliance. Financial support for the team is coordinated through <a href="https://robotics-catalyst.org" target="_blank" rel="noopener" class="text-blue-400 underline underline-offset-2 hover:text-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">Robotics Catalyst</a>, the STEM-education nonprofit that serves as our fiscal sponsor.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="https://robotics-catalyst.org/donate/allied-algorithms"
                   target="_blank" rel="noopener"
                   class="w-full sm:w-auto px-10 py-4 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                    Support Our Team
                </a>

                <a href="/contact-us/"
                   class="w-full sm:w-auto px-10 py-4 bg-transparent border border-zinc-700 hover:border-zinc-500 text-white font-semibold rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                    Contact Us
                </a>
            </div>
        </div>
    </section>

</Layout>
