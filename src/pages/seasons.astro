---
import Layout from '../layouts/Layout.astro';

const seasons = [
  {
    year: "2025-2026",
    theme: "Unearthed",
    tagline: "Uncovering the history of innovation.",
    awards: ["Champions Award", "Robot Performance Award"],
    robot_description: "Our most advanced robot yet, built for precision and modularity to tackle the complex missions of the Unearthed season. We won 1st place in regionals and we advanced to states. During the state competition we won the champions award and we advanced to Worlds!",
    robot_photo: "/images/robot/mk5/1.jpg",
    cover_photo: "/images/seasons/yr_25-26.jpg",
    is_current: true
  },
  {
    year: "2024-2025",
    theme: "Submerged",
    tagline: "Exploring the depths of innovation.",
    awards: [],
robot_description: "During 2024 season, we stood 2nd in Regionals. We created a river cleaning boat to clean our lakes and rivers. Basically our ponds and rivers are messy and they see trash easily and they would have to clean the trash the  hard way. So we created this boat which has a pulley system that can clean the trash the easy way.  ",
    cover_photo: "/images/seasons/yr_24-25.jpg",
    is_current: false
  },
  {
    year: "2023-2024",
    theme: "Masters Piece",
    tagline: "Crafting solutions like true artists.",
    awards: ["Robot Design Award"],
    robot_description: "During the Masterpiece season, our team reached a major milestone by placing 3rd at Regionals, qualifying us for our first-ever State Championship. We were honored to receive the Robot Design Award for our technical precision, while our innovative 3D hologram of the Seven Wonders showcased our ability to merge cutting-edge technology with creative storytelling.",
    cover_photo: "/images/seasons/yr_23-24.jpg",
    is_current: false
  },
  {
    year: "2022-2023",
    theme: "SUPERPOWERED",
    tagline: "In our very first FLL Challenge season, we hit the ground running with an ambitious innovation project aimed at saving energy by leveraging the power of gravity. Our hard work and creative problem-solving paid off immediately, as we secured 8th place at Regionals. It was a high-energy debut that proved our team was ready for the big stage!",
    awards: [],
    robot_description: "First season with the new SPIKE Prime system. Focused on building a reliable and versatile robot.",
    cover_photo: "/images/seasons/yr_22-23.jpg",
    is_current: false
  },
  {
    year: "2021-2022",
    theme: "CARGO CONNECT",
    tagline: "Connecting communities through smart transport.",
    awards: ["Programming Award"],
    robot_description: "During the Cargo Connect season, we tackled global logistics by designing a multi-modal delivery system. We envisioned using drones to transport cargo to difficult terrains like islands and deserts, while utilizing trucks for efficient last-mile delivery to residential homes. Our technical execution was a standout, earning us the prestigious Programming Award!",
    cover_photo: "/images/seasons/yr_21-22.jpg",
    is_current: false
  },
  {
    year: "2020-2021",
    theme: "REPLAY",
    tagline: "Our six-year FLL journey began with the Replay season, where we took our first steps into the world of competitive robotics. Tasked with finding creative ways to encourage exercise and physical activity, we focused our innovation project on making movement fun and accessible. This foundational year sparked our passion for engineering and set the stage for everything that followed.",
    awards: [],
    robot_description: "Our first season in FLL Explorer. Had a bunch of fun building and programming our robot.",
    cover_photo: "/images/seasons/yr_20-21.jpg",
    is_current: false
  }
];

const currentSeason = seasons.find(s => s.is_current);
const otherSeasons = seasons.filter(s => !s.is_current);

// Real chronological index (season 01 = our first year, oldest-first).
const seasonNumber = (season) => seasons.length - seasons.indexOf(season);

const title = "Seasons | Allied Algorithms";
---

<Layout title={title}>
  <main class="relative min-h-screen bg-[#030712] pt-32 pb-40 overflow-hidden">

    <div class="absolute inset-0 bg-blueprint-grid opacity-20 [mask-image:linear-gradient(to_bottom,black,transparent_70%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">

      <header class="mb-32 max-w-3xl">
        <p class="font-mono text-xs text-blue-400 uppercase tracking-widest mb-6">Competition Log &middot; 2020&ndash;2026</p>
        <h1 class="text-7xl md:text-[10rem] font-black italic text-white uppercase tracking-tighter leading-[0.75]">
            Our <span class="text-white/10">Journey.</span>
        </h1>
        <p class="mt-8 font-mono text-sm text-slate-500 leading-relaxed max-w-xl">
          Six seasons of builds, missions, and competition results &mdash; made possible in part by
          <a href="https://robotics-catalyst.org" class="text-blue-400 hover:text-accent underline underline-offset-4 transition-colors">a robotics-education nonprofit that supports teams like ours</a>,
          as we advanced from our first Explorer season to the World Championship.
        </p>
      </header>

      {currentSeason && (
        <section class="mb-48">
          <div class="relative">
            <div class="relative z-10 aspect-[16/8] rounded-3xl overflow-hidden border border-white/20 shadow-xl">
                <img src={currentSeason.cover_photo} alt={currentSeason.theme} class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#030712] via-transparent to-transparent"></div>
            </div>

            <div class="relative z-20 -mt-32 ml-auto max-w-2xl p-12 lg:p-16 bg-[#0a0f1a] border border-white/10 rounded-3xl mr-8 lg:mr-16">
                <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-blue-500/40"></span>
                <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-blue-500/40"></span>

                <div class="flex flex-wrap items-center gap-4 mb-6 font-mono text-xs uppercase tracking-widest">
                    <span class="text-accent">// Current Season</span>
                    <span class="text-white/40">{currentSeason.year}</span>
                    <span class="text-white/20">Season {String(seasonNumber(currentSeason)).padStart(2, '0')}</span>
                </div>

                <h2 class="text-5xl lg:text-7xl font-bold text-white uppercase tracking-tight mb-6 leading-none">
                  {currentSeason.theme}
                </h2>

                <p class="text-slate-300 text-xl font-light leading-relaxed mb-10">
                    {currentSeason.robot_description}
                </p>

                {currentSeason.awards.length > 0 && (
                  <div class="flex flex-wrap gap-x-6 gap-y-2 pt-8 border-t border-white/10 font-mono text-xs text-blue-300 uppercase tracking-wide">
                    {currentSeason.awards.map(award => (
                      <span class="flex items-center gap-2"><span class="text-blue-500">&mdash;</span>{award}</span>
                    ))}
                  </div>
                )}
            </div>
          </div>
        </section>
      )}

      <section>
        <div class="flex items-center gap-6 mb-16 px-4">
            <h3 class="font-mono text-xs text-blue-400 uppercase tracking-widest">Technical Lineage</h3>
            <div class="h-px flex-1 bg-white/10"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {otherSeasons.map((season) => (
            <div class="relative flex flex-col bg-white/[0.02] border border-white/5 rounded-2xl transition-colors duration-300 hover:border-white/20">

              <div class="aspect-[16/10] overflow-hidden rounded-t-2xl relative">
                 <img src={season.cover_photo} alt={season.theme} class="w-full h-full object-cover" />
                 <div class="absolute inset-0 bg-gradient-to-t from-[#030712]/60 to-transparent"></div>
              </div>

              <div class="p-10 lg:p-12">
                <div class="flex justify-between items-center mb-6 font-mono text-xs text-slate-500 uppercase tracking-widest">
                    <span>Season {String(seasonNumber(season)).padStart(2, '0')}</span>
                    <span>{season.year}</span>
                </div>

                <h4 class="text-3xl lg:text-4xl font-bold text-white uppercase tracking-tight mb-6 leading-none">
                  {season.theme}
                </h4>

                <p class="text-slate-400 text-lg font-light leading-relaxed mb-10">
                  {season.robot_description}
                </p>

                {season.awards.length > 0 && (
                  <div class="flex flex-wrap gap-x-6 gap-y-2 pt-8 border-t border-white/5 font-mono text-xs text-blue-300 uppercase tracking-wide">
                    {season.awards.map(award => (
                      <span class="flex items-center gap-2"><span class="text-blue-500">&mdash;</span>{award}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </main>
</Layout>
