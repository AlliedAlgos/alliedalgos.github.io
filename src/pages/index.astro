---
import Layout from '../layouts/Layout.astro';
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';

const sponsorsRaw = readFileSync('./src/data/sponsors.toml', 'utf-8');
const { sponsors } = parse(sponsorsRaw);

const title = "Allied Algorithms | Wilton's FLL Robotics Team 600757";
const description = "Representing Wilton, CT in FIRST LEGO League. 7,700+ global views. We combine competitive excellence with an open-source philosophy.";

const socialLinks = [
  { name: 'YouTube', icon: 'youtube', isBrand: true, href: 'https://youtube.com/@alliedalgorithms' },
  { name: 'Facebook', icon: 'facebook', isBrand: true, href: 'https://facebook.com' },
  { name: 'Instagram', icon: 'instagram', isBrand: true, href: 'https://instagram.com/allied.aloriths' },
  { name: 'GitHub', icon: 'github', isBrand: true, href: 'https://github.com/alliedalgos' },
  { name: 'Website', icon: 'globe', isBrand: false, href: '/' }
];
---

<Layout title={title} description={description}>
  <div class="w-full text-white font-mono bg-[#60a5fa]">

    <!-- Hero Sticky Scroll Runway -->
    <div id="hero-trigger" class="relative h-[160vh] w-full">
      <div class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden p-0 z-10">

        <!-- Expanding Hero Card -->
        <section
          id="hero-card"
          class="relative w-full max-w-[92%] sm:max-w-[88%] h-[85vh] sm:h-[82vh] rounded-[2rem] md:rounded-[3rem] bg-blue-500/90 border border-white/20 shadow-2xl flex flex-col justify-center overflow-hidden transition-all duration-75 ease-out backdrop-blur-md will-change-[border-radius,max-width,width,height]"
        >
          <!-- Blueprint Grid Background -->
          <div class="absolute inset-0 bg-blueprint-grid opacity-20 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,black,transparent_80%)] -webkit-[mask-image:radial-gradient(ellipse_70%_60%_at_50%_30%,black,transparent_80%)] pointer-events-none"></div>

          <!-- Hero Content -->
          <div class="max-w-6xl mx-auto px-5 sm:px-8 md:px-12 w-full relative z-10 py-4 sm:py-6 md:py-8 flex flex-col justify-center h-full">
            <p class="fade-up text-xs md:text-sm uppercase tracking-widest text-blue-100 mb-2 sm:mb-4">
              Wilton, CT &middot; Team 600757
            </p>

            <!-- Shortened Team Name on Mobile (Bigger Font Size) -->
            <h1 class="fade-up font-black italic tracking-tighter uppercase leading-[0.88] sm:leading-[0.85] mb-4 sm:mb-6 text-white break-words">
              <!-- Mobile view (Larger text) -->
              <span class="block sm:hidden text-5xl sm:text-6xl">
                Allied <br />
                <span class="text-blue-100">Algos</span>
              </span>
              <!-- Desktop view -->
              <span class="hidden sm:block text-5xl sm:text-7xl md:text-[7.5rem] lg:text-[9.5rem]">
                Allied <br />
                <span class="text-blue-100">Algorithms</span>
              </span>
            </h1>

            <p class="fade-up text-base sm:text-xl md:text-3xl text-white font-bold max-w-2xl mb-6 md:mb-8">
              Where Engineering Meets Creativity
            </p>

            <!-- Stats & Social Links -->
            <div class="fade-up relative inline-flex flex-wrap items-center gap-4 sm:gap-6 md:gap-10 px-4 sm:px-6 md:px-8 py-3 sm:py-5 border border-white/20 bg-blue-600/50 backdrop-blur-md rounded-2xl mb-6 max-w-fit shadow-lg">
              <span class="absolute -top-px -left-px w-3 h-3 sm:w-4 sm:h-4 border-t border-l border-white/40"></span>
              <span class="absolute -bottom-px -right-px w-3 h-3 sm:w-4 sm:h-4 border-b border-r border-white/40"></span>

              <div class="text-left">
                <span class="block text-[9px] sm:text-[10px] md:text-[11px] uppercase tracking-widest text-blue-100 mb-1">Combined Global Reach</span>
                <span class="flex items-baseline gap-2">
                  <span id="view-count" data-target="21891" class="text-2xl sm:text-4xl md:text-5xl text-white tabular-nums font-bold">0</span>
                  <span class="text-[10px] sm:text-xs md:text-sm text-blue-100 uppercase">Views</span>
                </span>
              </div>

              <div class="h-8 sm:h-10 w-px bg-white/20 hidden sm:block"></div>

              <!-- Social Media Icon Links -->
              <div class="flex items-center gap-2 sm:gap-3">
                {socialLinks.map((item) => {
                  const prefix = item.isBrand ? 'fa-brands' : 'fa-solid';
                  return (
                    <a
                      href={item.href}
                      target={item.href.startsWith('http') ? "_blank" : "_self"}
                      rel="noopener noreferrer"
                      aria-label={item.name}
                      class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl border border-white/20 bg-white/10 flex items-center justify-center text-white hover:border-white/50 hover:bg-white/20 hover:scale-105 transition-all duration-200"
                    >
                      <i class={`${prefix} fa-${item.icon} text-xs sm:text-sm`}></i>
                    </a>
                  );
                })}
              </div>
            </div>

            <!-- CTA -->
            <div class="fade-up flex flex-wrap gap-4 sm:gap-6">
              <a href="/seasons/" class="group inline-flex items-center gap-3 px-6 sm:px-8 py-3 sm:py-4 bg-blue-700 text-white font-semibold text-xs sm:text-sm tracking-wide rounded-xl hover:bg-blue-800 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-200 shadow-xl border border-white/20">
                Explore Journey
                <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- Team Photo Section -->
    <section class="py-20 bg-blue-500 border-t border-white/20 relative z-25">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 fade-up relative aspect-[16/10] rounded-3xl overflow-hidden border border-white/20 shadow-2xl bg-blue-600/40 group">
            <img
              src="/images/team-photo.jpg"
              alt="Allied Algorithms Team Photo"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
            />
            <!-- Fallback container -->
            <div class="hidden absolute inset-0 flex flex-col items-center justify-center p-8 text-center bg-blue-700/80 backdrop-blur-md">
              <i class="fa-solid fa-users text-4xl text-white mb-4"></i>
              <p class="text-xs uppercase tracking-widest text-blue-100">Team Photo Placeholder</p>
              <p class="text-xs text-blue-200 mt-2">Add your image to <code class="text-white">/public/images/team-photo.jpg</code></p>
            </div>
          </div>
          <div class="lg:col-span-5 fade-up">
            <span class="text-xs uppercase tracking-widest text-blue-100 mb-3 block">Meet The Innovators</span>
            <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight mb-6">
              Driven by Passion, Built on Teamwork.
            </h2>
            <p class="text-blue-50 text-base md:text-lg leading-relaxed font-light mb-6">
              Allied Algorithms brings together young engineers, coders, and creators from Wilton, CT. Guided by FIRST LEGO League values, our team pushes the boundaries of autonomous robotics and creative problem solving every season.
            </p>
            <div class="flex items-center gap-4 text-xs text-blue-100 uppercase tracking-wider border-t border-white/20 pt-4">
              <span>Wilton, CT</span>
              <span>&bull;</span>
              <span>FLL Team #600757</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Competition Section -->
    <section class="max-w-7xl mx-auto px-6 py-24 md:py-40 relative z-25">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="fade-up">
          <span class="text-xs uppercase tracking-widest text-blue-900 mb-4 block font-bold">The Competition</span>
          <h2 class="text-4xl md:text-6xl font-semibold text-white leading-tight tracking-tight mb-8">
            FIRST LEGO <br><span class="text-blue-900">League.</span>
          </h2>
          <p class="text-blue-950 text-lg leading-relaxed font-semibold mb-10 max-w-lg">
            FIRST® LEGO® League (FLL) is a global STEM program that introduces science, technology, engineering, and math through hands-on learning.
          </p>
          <div class="grid grid-cols-2 gap-8 border-t border-white/30 pt-10">
            <div>
              <span class="block text-white font-semibold text-xl mb-2">Innovation</span>
              <p class="text-[11px] uppercase tracking-widest text-blue-950 font-extrabold">Project Research</p>
            </div>
            <div>
              <span class="block text-white font-semibold text-xl mb-2">Robotics</span>
              <p class="text-[11px] uppercase tracking-widest text-blue-950 font-extrabold">Autonomous Systems</p>
            </div>
          </div>
        </div>

        <div class="fade-up relative aspect-square rounded-3xl overflow-hidden bg-blue-600/40 border border-white/20 p-10 md:p-14 flex flex-col justify-end shadow-2xl backdrop-blur-md">
          <span class="absolute top-5 left-5 w-4 h-4 border-t border-l border-white/50"></span>
          <span class="absolute bottom-5 right-5 w-4 h-4 border-b border-r border-white/50"></span>
          <span class="text-xs uppercase tracking-widest text-blue-100 mb-3 block">Seasons Archived</span>
          <span class="text-6xl md:text-7xl text-white tabular-nums leading-none mb-6 font-bold">07</span>
          <h3 class="text-2xl font-semibold text-white mb-3">7 Seasons of Excellence</h3>
          <p class="text-blue-50 font-light">From initial breakthroughs to present day, we've built a strong legacy of technical documentation and innovation.</p>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script is:inline>
  // Hero Scroll-Expansion Logic
  const heroTrigger = document.getElementById('hero-trigger');
  const heroCard = document.getElementById('hero-card');

  function handleHeroExpand() {
    if (!heroTrigger || !heroCard) return;

    const rect = heroTrigger.getBoundingClientRect();
    const scrollableDistance = heroTrigger.offsetHeight - window.innerHeight;

    if (scrollableDistance <= 0) return;

    // Progress percentage between 0 and 1
    const progress = Math.min(Math.max(-rect.top / scrollableDistance, 0), 1);

    const isMobile = window.innerWidth < 768;
    const initialRadius = isMobile ? 32 : 48; // px

    const currentRadius = initialRadius * (1 - progress);
    const heightPercent = 85 + (15 * progress); // Grows to 100vh

    // Width expansion setup
    const initialWidth = isMobile ? 92 : 88;
    const widthPercent = initialWidth + ((100 - initialWidth) * progress);

    // Apply exact dimensions
    heroCard.style.borderRadius = `${currentRadius}px`;
    heroCard.style.height = `${heightPercent}vh`;

    if (progress >= 0.99) {
      heroCard.style.maxWidth = '100vw';
      heroCard.style.width = '100vw';
    } else {
      heroCard.style.maxWidth = `${widthPercent}%`;
      heroCard.style.width = `${widthPercent}%`;
    }
  }

  window.addEventListener('scroll', () => requestAnimationFrame(handleHeroExpand), { passive: true });
  window.addEventListener('resize', handleHeroExpand);

  // Counter animation logic
  function animateValue(obj, start, end, duration) {
    let startTimestamp = null;
    const step = (timestamp) => {
      if (!startTimestamp) startTimestamp = timestamp;
      const progress = Math.min((timestamp - startTimestamp) / duration, 1);
      obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString();
      if (progress < 1) window.requestAnimationFrame(step);
    };
    window.requestAnimationFrame(step);
  }

  // Intersection Observer for fade-up elements & counter
  const observerOptions = { threshold: 0.1 };
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        if (entry.target.contains(document.getElementById('view-count'))) {
          const counter = document.getElementById('view-count');
          if (counter && counter.innerText === "0") {
            const target = parseInt(counter.getAttribute('data-target') || '0', 10);
            animateValue(counter, 0, target, 2000);
          }
        }
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
