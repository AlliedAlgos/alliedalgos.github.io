---
import Layout from '../layouts/Layout.astro';
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';
import SponsorReel from '../components/SponsorReel.astro';

const sponsorsRaw = readFileSync('./src/data/sponsors.toml', 'utf-8');
const { sponsors } = parse(sponsorsRaw);

const title = "Allied Algorithms | Wilton's FLL Robotics Team 600757";
const description = "Representing Wilton, CT in FIRST LEGO League. 7,700+ global views. We combine competitive excellence with an open-source philosophy.";
---

<Layout title={title} description={description}>
    <div class="flex flex-col">

        <section class="relative min-h-screen flex items-center pt-32 overflow-hidden order-1">
            <div class="absolute inset-0 bg-blueprint-grid opacity-40 [-webkit-mask-image:radial-gradient(ellipse_65%_55%_at_50%_20%,black,transparent_75%)] [mask-image:radial-gradient(ellipse_65%_55%_at_50%_20%,black,transparent_75%)]"></div>

            <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
                <p class="fade-up font-mono text-xs md:text-sm uppercase tracking-widest text-zinc-500 mb-8">
                    Wilton, CT &middot; Team 600757
                </p>

                <h1 class="fade-up text-6xl md:text-[10rem] font-black italic tracking-tighter leading-[0.85] uppercase mb-10 text-white break-words">
                    Allied <br />
                    <span class="text-blue-500">Algorithms.</span>
                </h1>
                <p class="fade-up text-xl md:text-2xl text-zinc-400 font-light max-w-2xl mb-14">
                    Where Engineering Meets Creativity
                </p>

                <div class="fade-up relative inline-flex flex-wrap items-stretch gap-8 md:gap-12 px-8 md:px-10 py-7 md:py-8 border border-white/10 rounded-lg mb-16">
                    <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-accent/50"></span>
                    <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-accent/50"></span>

                    <div class="text-left">
                        <span class="block font-mono text-[11px] uppercase tracking-widest text-zinc-500 mb-3">Combined Global Reach</span>
                        <span class="flex items-baseline gap-2">
                            <span id="view-count" data-target="14891" class="font-mono text-4xl md:text-5xl text-white tabular-nums">0</span>
                            <span class="font-mono text-sm text-zinc-500 uppercase">Views</span>
                        </span>
                    </div>
                    <div class="w-px bg-white/10 hidden md:block"></div>
                    <div class="flex items-center gap-4">
                        {['youtube', 'facebook', 'instagram', 'globe'].map((icon) => {
                        // Determine if it's a brand or a standard solid icon
                        const isBrand = icon !== 'globe';
                        const prefix = isBrand ? 'fa-brands' : 'fa-solid';

                        return (
                            <div
                            data-icon={icon}
                            class="w-9 h-9 rounded border border-white/10 flex items-center justify-center text-sm text-zinc-500"
                            >
                            <i class={`${prefix} fa-${icon}`}></i>
                            </div>
                        );
                        })}
                    </div>
                </div>

                <div class="fade-up flex flex-wrap gap-8 mb-24">
                    <a href="/seasons/" class="group inline-flex items-center gap-3 px-8 py-4 bg-blue-600 text-white font-semibold text-sm tracking-wide rounded-lg hover:bg-blue-500 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                        Explore Journey
                        <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
                    </a>
                </div>
            </div>
        </section>

        <section class="py-20 bg-zinc-950 order-2">
            <SponsorReel sponsors={sponsors} />
        </section>

        <section class="max-w-7xl mx-auto px-6 py-24 md:py-40 order-3 lg:order-5">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
                <div class="fade-up">
                    <span class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-4 block">The Competition</span>
                    <h2 class="text-4xl md:text-6xl font-semibold text-white leading-tight tracking-tight mb-8">
                        FIRST LEGO <br><span class="text-zinc-500">League.</span>
                    </h2>
                    <p class="text-zinc-400 text-lg leading-relaxed font-light mb-10 max-w-lg">
                        FIRST® LEGO® League (FLL) is a global STEM program that introduces science, technology, engineering, and math through hands-on learning.
                    </p>
                    <div class="grid grid-cols-2 gap-8 border-t border-white/10 pt-10">
                        <div>
                            <span class="block text-white font-semibold text-xl mb-2">Innovation</span>
                            <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500">Project Research</p>
                        </div>
                        <div>
                            <span class="block text-white font-semibold text-xl mb-2">Robotics</span>
                            <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500">Autonomous Systems</p>
                        </div>
                    </div>
                </div>
                <div class="fade-up relative aspect-square rounded-2xl overflow-hidden bg-zinc-900/60 border border-white/10 p-10 md:p-14 flex flex-col justify-end">
                    <span class="absolute top-5 left-5 w-4 h-4 border-t border-l border-blue-500/40"></span>
                    <span class="absolute bottom-5 right-5 w-4 h-4 border-b border-r border-blue-500/40"></span>
                    <span class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-3">Seasons Archived</span>
                    <span class="font-mono text-6xl md:text-7xl text-white tabular-nums leading-none mb-6">06</span>
                    <h3 class="text-2xl font-semibold text-white mb-3">6 Seasons of Excellence</h3>
                    <p class="text-zinc-400 font-light">From Masterpiece to Submerged, we've built a legacy of technical documentation.</p>
                </div>
            </div>
        </section>

        <section class="bg-slate-950 py-20 md:py-28 rounded-3xl mx-1 md:mx-2 overflow-hidden border border-white/5 order-4">
            <div class="max-w-6xl mx-auto px-6">
                <div class="text-center mb-16">
                    <span class="font-mono text-xs uppercase tracking-widest text-slate-500 mb-4 block">Our Engineering Culture</span>
                    <h2 class="text-4xl md:text-6xl font-semibold text-white leading-tight tracking-tight mb-6">
                        Open Source.
                    </h2>
                    <p class="text-slate-400 text-lg max-w-xl mx-auto font-light leading-relaxed">
                        We believe in the "Allied" part of our name. We publish our technical logs and CAD to elevate the entire FLL community.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                    {[
                        { icon: 'code-branch', tag: 'GitHub Repositories', title: 'Frameworks', desc: 'Reusable code architectures for precision and reliability.' },
                        { icon: 'cube', tag: '3D / CAD Files', title: 'CAD Assets', desc: '3D models shared to assist teams in mastering structural integrity.' },
                        { icon: 'book-open', tag: 'Engineering Notebook', title: 'Public Logs', desc: 'A full archive of our design iterations and breakthroughs.' }
                    ].map((item) => (
                        <div class="p-6 md:p-8 border border-white/5 rounded-xl hover:border-blue-500/30 transition-colors">
                            <div class="flex items-center gap-2.5 mb-5">
                                <i class={`fa-solid fa-${item.icon} text-blue-500/70 text-sm`}></i>
                                <span class="font-mono text-[10px] uppercase tracking-widest text-slate-500">{item.tag}</span>
                            </div>
                            <h4 class="text-lg font-semibold text-white mb-2">{item.title}</h4>
                            <p class="font-light text-sm text-slate-400 leading-relaxed">{item.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

    </div>
</Layout>

<script is:inline>
    function animateValue(obj, start, end, duration) {
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            obj.innerHTML = Math.floor(progress * (end - start) + start).toLocaleString();
            if (progress < 1) window.requestAnimationFrame(step);
        };
        window.requestAnimationFrame(step);
    }

    const observerOptions = { threshold: 0.1 };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                if (entry.target.contains(document.getElementById('view-count'))) {
                    const counter = document.getElementById('view-count');
                    if (counter && counter.innerText === "0") {
                        const target = parseInt(counter.getAttribute('data-target'));
                        animateValue(counter, 0, target, 2000);
                    }
                }
            }
        });
    }, observerOptions);

    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
