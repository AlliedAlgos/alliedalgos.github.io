---
import Layout from '../../layouts/Layout.astro';

const title = "Global Telemetry | Allied Algorithms";
const description = "Interactive 3D globe displaying our team locations, partner venues, and event stops loaded from data.json.";
---

<Layout title={title} description={description}>
    <!-- Load MapLibre GL CSS and JS CDN -->
    <head>
        <link href="https://unpkg.com/maplibre-gl@5.0.0/dist/maplibre-gl.css" rel="stylesheet" />
        <script src="https://unpkg.com/maplibre-gl@5.0.0/dist/maplibre-gl.js"></script>
    </head>

    <main class="font-mono relative min-h-screen overflow-hidden bg-[#60a5fa] text-white">

        <!-- Blueprint Grid Background Texture -->
        <div class="absolute inset-0 bg-blueprint-grid opacity-10 pointer-events-none z-0"></div>

        <!-- Top Fixed Header -->
        <section class="relative pt-32 pb-12 overflow-hidden z-10 text-center">
            <div class="max-w-4xl mx-auto px-6">
                <p class="font-mono text-xs uppercase tracking-widest text-blue-100 mb-2 font-semibold">Telemetry &middot; Team 600757</p>
                <h1 class="text-5xl md:text-7xl font-black tracking-tighter italic text-white uppercase drop-shadow-md">
                    Global <span class="text-blue-100/70">Map.</span>
                </h1>
                <p class="text-blue-50 text-sm md:text-base max-w-xl mx-auto font-light mt-4">
                    Interactive 3D globe plotting our venues and event data dynamically parsed from <code class="bg-blue-950/60 px-2 py-0.5 rounded text-xs text-blue-200">data.json</code>.
                </p>
            </div>
        </section>

        <!-- Map Container Section -->
        <section class="max-w-6xl mx-auto px-6 pb-28 relative z-10">
            <div class="relative bg-blue-900/50 border border-white/25 rounded-3xl p-4 md:p-6 backdrop-blur-md shadow-2xl overflow-hidden">
                <!-- Blueprint corner accents -->
                <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-white/40 z-20"></span>
                <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-white/40 z-20"></span>

                <!-- Map Element -->
                <div id="map" class="w-full h-[600px] rounded-2xl overflow-hidden border border-white/15 shadow-inner"></div>
            </div>
        </section>

    </main>

    <script is:inline>
        // Initialize MapLibre Map instance
        const map = new maplibregl.Map({
            container: 'map',
            style: 'https://demotiles.maplibre.org/style.json',
            center: [-73.4082, 41.1866], // Default center (Wilton, CT)
            zoom: 2,
            maxPitch: 85
        });

        // Upgrade map projection to 3D Globe once style loads
        map.on('style.load', () => {
            map.setProjection({ type: 'globe' });

            // Add navigation zoom controls
            map.addControl(new maplibregl.NavigationControl(), 'top-right');

            // Fetch point data from data.json
            fetch('./data.json')
                .then(response => response.json())
                .then(data => {
                    // Support standard GeoJSON FeatureCollection or an array of coordinates
                    let geojson;
                    if (data.type === 'FeatureCollection') {
                        geojson = data;
                    } else if (Array.isArray(data)) {
                        geojson = {
                            type: 'FeatureCollection',
                            features: data.map(item => ({
                                type: 'Feature',
                                geometry: {
                                    type: 'Point',
                                    coordinates: [item.longitude || item.lng || 0, item.latitude || item.lat || 0]
                                },
                                properties: item
                            }))
                        };
                    } else {
                        geojson = data;
                    }

                    // Add data source to map
                    map.addSource('team-locations', {
                        type: 'geojson',
                        data: geojson
                    });

                    // Add styled marker circles layer
                    map.addLayer({
                        id: 'locations-layer',
                        type: 'circle',
                        source: 'team-locations',
                        paint: {
                            'circle-radius': 8,
                            'circle-color': '#ffffff',
                            'circle-stroke-width': 3,
                            'circle-stroke-color': '#1e3a8a'
                        }
                    });

                    // Add popup interaction on click
                    map.on('click', 'locations-layer', (e) => {
                        const coordinates = e.features[0].geometry.coordinates.slice();
                        const props = e.features[0].properties;

                        const title = props.title || props.name || props.theme || 'Location Node';
                        const desc = props.description || props.tagline || 'Team 600757 checkpoint coordinate.';

                        while (Math.abs(e.lngLat.lng - coordinates[0]) > 180) {
                            coordinates[0] += e.lngLat.lng > coordinates[0] ? 360 : -360;
                        }

                        new maplibregl.Popup({ offset: 15 })
                            .setLngLat(coordinates)
                            .setHTML(`
                                <div style="font-family: monospace; color: #1e3a8a; padding: 6px;">
                                    <strong style="font-size: 13px; text-transform: uppercase; display: block; margin-bottom: 3px;">${title}</strong>
                                    <span style="font-size: 11px; color: #475569;">${desc}</span>
                                </div>
                            `)
                            .addTo(map);
                    });

                    // Change cursor on hover over points
                    map.on('mouseenter', 'locations-layer', () => {
                        map.getCanvas().style.cursor = 'pointer';
                    });
                    map.on('mouseleave', 'locations-layer', () => {
                        map.getCanvas().style.cursor = '';
                    });
                })
                .catch(error => {
                    console.error('Failed to load telemetry dataset from data.json:', error);
                });
        });
    </script>
</Layout>
