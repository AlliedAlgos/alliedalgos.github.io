<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multiflora Tracker - Realtime Invasive Species Mapping</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 5px rgba(16, 185, 129, 0.4), 0 0 10px rgba(16, 185, 129, 0.2)' },
                            '100%': { boxShadow: '0 0 20px rgba(16, 185, 129, 0.8), 0 0 30px rgba(16, 185, 129, 0.4)' }
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- MapLibre GL CSS -->
    <link href="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.css" rel="stylesheet">
    <script src="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.js"></script>

    <!-- Custom Utility Styles -->
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow: hidden;
        }

        /* Glassmorphic utilities */
        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(51, 65, 85, 0.8);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(71, 85, 105, 1);
        }

        /* Map custom overrides */
        .maplibregl-popup-content {
            background: transparent !important;
            padding: 0 !important;
            box-shadow: none !important;
        }
        .maplibregl-popup-anchor-top .maplibregl-popup-tip { border-bottom-color: #0f172a !important; }
        .maplibregl-popup-anchor-bottom .maplibregl-popup-tip { border-top-color: #0f172a !important; }
        .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: #0f172a !important; }
        .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: #0f172a !important; }

        /* Custom marker pulse aura */
        .marker-pin-wrapper {
            position: relative;
            cursor: pointer;
        }
        .marker-pulse {
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.6); opacity: 0.9; }
            50% { opacity: 0.5; }
            100% { transform: scale(1.6); opacity: 0; }
        }

        .crosshair-cursor #map {
            cursor: crosshair !important;
        }
    </style>
</head>

<body class="h-full w-full relative select-none antialiased text-slate-100 bg-slate-950">

    <!-- MAIN FULLSCREEN MAP CONTAINER -->
    <div id="map" class="absolute inset-0 w-full h-full z-0"></div>

    <!-- MAP PICKING BANNER (Appears when map picking mode is active) -->
    <div id="pickingBanner" class="hidden fixed top-20 left-1/2 -translate-x-1/2 z-30 flex items-center gap-3 px-5 py-2.5 rounded-full glass-panel border border-amber-500/40 text-amber-300 text-sm font-medium shadow-2xl animate-bounce">
        <svg class="w-5 h-5 text-amber-400 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
        </svg>
        <span>Click anywhere on the map to drop coordinates</span>
        <button id="cancelPickBtn" class="ml-2 px-2 py-0.5 text-xs bg-amber-500/20 hover:bg-amber-500/40 text-amber-200 rounded-full border border-amber-500/30 transition">
            Cancel
        </button>
    </div>

    <!-- FLOATING TOP HEADER -->
    <header class="fixed top-4 left-4 right-4 z-20 flex items-center justify-between px-5 py-3 rounded-2xl glass-panel shadow-2xl transition-all">
        <!-- Brand / Title -->
        <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 p-0.5 shadow-lg shadow-emerald-950/50 flex items-center justify-center">
                <div class="w-full h-full bg-slate-950/40 rounded-[10px] flex items-center justify-center backdrop-blur-sm">
                    <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                </div>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-base font-bold tracking-tight text-white leading-none">Multiflora Tracker</h1>
                    <span id="networkStatusBadge" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        LIVE SYNC
                    </span>
                </div>
                <p class="text-xs text-slate-400 mt-0.5">Detect • Map • Protect Invasive Species</p>
            </div>
        </div>

        <!-- Dashboard Stat Badges (Desktop) -->
        <div class="hidden md:flex items-center gap-3">
            <div class="glass-card px-3.5 py-1.5 rounded-xl flex items-center gap-2.5">
                <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Total Sites</div>
                    <div id="statTotalCount" class="text-sm font-extrabold text-white leading-none">0</div>
                </div>
            </div>

            <div class="glass-card px-3.5 py-1.5 rounded-xl flex items-center gap-2.5">
                <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Under Watch</div>
                    <div id="statWatchCount" class="text-sm font-extrabold text-white leading-none">0</div>
                </div>
            </div>

            <div class="glass-card px-3.5 py-1.5 rounded-xl flex items-center gap-2.5">
                <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                <div>
                    <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Treated</div>
                    <div id="statTreatedCount" class="text-sm font-extrabold text-white leading-none">0</div>
                </div>
            </div>
        </div>
    </header>

    <!-- FLOATING CENTER-BOTTOM CONTROL BAR -->
    <nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 px-3 py-2.5 rounded-2xl glass-panel shadow-2xl border border-slate-700/60 max-w-[95vw] sm:max-w-none overflow-x-auto">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[140px] sm:min-w-[200px]">
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
                type="text"
                id="searchInput"
                placeholder="Search locations..."
                class="w-full bg-slate-900/90 border border-slate-700/70 rounded-xl pl-9 pr-8 py-2 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/50 transition"
            >
            <button id="clearSearchBtn" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs">
                ✕
            </button>
        </div>

        <div class="h-6 w-px bg-slate-800 mx-1"></div>

        <!-- Add Location Button -->
        <button id="openAddModalBtn" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-semibold text-xs shadow-lg shadow-emerald-950/60 transition active:scale-95 whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            <span>Add Sighting</span>
        </button>

        <!-- Pick on Map Quick Action -->
        <button id="startPickMapBtn" title="Pick coordinates directly on the map" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition active:scale-95 flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </button>

        <!-- List Drawer Toggle Button -->
        <button id="toggleListBtn" title="View all sightings in side panel" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition active:scale-95 relative flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span id="listBadgeCount" class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 text-slate-950 font-bold text-[9px] flex items-center justify-center border border-slate-900">0</span>
        </button>

        <!-- Reset Map View Button -->
        <button id="resetViewBtn" title="Recenter map to fit all markers" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition active:scale-95 flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
        </button>

        <!-- CSV Export Button -->
        <button id="exportCsvBtn" title="Export locations to CSV file" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700/60 transition active:scale-95 flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
        </button>
    </nav>

    <!-- RIGHT SIDE DRAWER (Locations Directory) -->
    <aside id="listDrawer" class="fixed top-20 right-4 bottom-24 z-20 w-80 sm:w-96 glass-panel rounded-2xl shadow-2xl border border-slate-700/60 flex flex-col translate-x-[120%] transition-transform duration-300 ease-in-out">
        <!-- Drawer Header -->
        <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <h2 class="font-bold text-sm text-white">Recorded Sightings Directory</h2>
            </div>
            <button id="closeListBtn" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition">
                ✕
            </button>
        </div>

        <!-- Drawer Content List -->
        <div id="drawerListContent" class="flex-1 overflow-y-auto p-3 space-y-2.5">
            <!-- Dynamic Location Items Injected Here -->
        </div>

        <!-- Drawer Footer -->
        <div class="p-3 border-t border-slate-800 bg-slate-950/40 rounded-b-2xl flex items-center justify-between text-xs text-slate-400">
            <span>Showing <span id="drawerVisibleCount" class="font-bold text-white">0</span> site records</span>
            <button id="seedDataBtn" class="text-xs text-emerald-400 hover:text-emerald-300 font-semibold underline">
                Load Sample Data
            </button>
        </div>
    </aside>

    <!-- MODAL: ADD / EDIT LOCATION -->
    <div id="addModalOverlay" class="hidden fixed inset-0 z-40 bg-slate-950/70 backdrop-blur-md flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-2xl shadow-2xl border border-slate-700/70 overflow-hidden animate-in fade-in zoom-in duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/50">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-base text-white">Record Multiflora Spot</h3>
                        <p class="text-xs text-slate-400">Save coordinates and observation data</p>
                    </div>
                </div>
                <button id="closeAddModalBtn" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition">
                    ✕
                </button>
            </div>

            <!-- Modal Form -->
            <form id="addLocationForm" class="p-6 space-y-4">
                <!-- Location Name -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Site / Spot Name *</label>
                    <input
                        type="text"
                        id="formName"
                        required
                        placeholder="e.g. Pine Ridge Trailhead Cluster"
                        class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                    >
                </div>

                <!-- Lat / Lng inputs -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Latitude *</label>
                        <input
                            type="number"
                            step="any"
                            id="formLat"
                            required
                            placeholder="41.195"
                            class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                        >
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Longitude *</label>
                        <input
                            type="number"
                            step="any"
                            id="formLng"
                            required
                            placeholder="-73.438"
                            class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                        >
                    </div>
                </div>

                <!-- Coordinates Assistant Buttons -->
                <div class="flex items-center gap-2">
                    <button type="button" id="useGpsBtn" class="flex-1 flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        </svg>
                        <span>Use My GPS</span>
                    </button>
                    <button type="button" id="formPickMapBtn" class="flex-1 flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 text-xs border border-slate-700 transition">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5" />
                        </svg>
                        <span>Pick on Map</span>
                    </button>
                </div>

                <!-- Date & Status -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Date Recorded</label>
                        <input
                            type="date"
                            id="formDate"
                            class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500"
                        >
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Status</label>
                        <select id="formStatus" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="Identified Sighting">Identified Sighting</option>
                            <option value="Under Watch">Under Watch</option>
                            <option value="Treated / Removed">Treated / Removed</option>
                        </select>
                    </div>
                </div>

                <!-- Notes / Description -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Observation Notes</label>
                    <textarea
                        id="formNotes"
                        rows="2"
                        placeholder="Density details, plant height, or land area..."
                        class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500"
                    ></textarea>
                </div>

                <!-- Form Submit Action -->
                <div class="pt-2 flex items-center justify-end gap-3">
                    <button type="button" id="cancelFormBtn" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold text-xs shadow-lg shadow-emerald-950/50 transition">
                        Save Sighting
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: LOCATION DETAIL VIEW -->
    <div id="detailModalOverlay" class="hidden fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-md flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-2xl shadow-2xl border border-slate-700/80 overflow-hidden animate-in fade-in zoom-in duration-200">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between bg-slate-900/60">
                <div class="flex items-center gap-3">
                    <div id="detailStatusIcon" class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold text-sm">
                        🌿
                    </div>
                    <div>
                        <h3 id="detailName" class="font-bold text-base text-white leading-tight">Location Title</h3>
                        <div id="detailBadge" class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 mt-1">
                            Identified Sighting
                        </div>
                    </div>
                </div>
                <button id="closeDetailModalBtn" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition">
                    ✕
                </button>
            </div>

            <!-- Details Content -->
            <div class="p-6 space-y-4">
                <!-- Coordinates Card -->
                <div class="glass-card p-3.5 rounded-xl border border-slate-800 flex items-center justify-between">
                    <div>
                        <div class="text-[10px] uppercase font-bold text-slate-400">GPS Coordinates</div>
                        <div class="text-xs font-mono text-emerald-400 mt-0.5">
                            <span id="detailLat">0.000000</span>, <span id="detailLng">0.000000</span>
                        </div>
                    </div>
                    <button id="copyCoordsBtn" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs flex items-center gap-1 transition">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>Copy</span>
                    </button>
                </div>

                <!-- Recorded Date & Quick Status Switcher -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="glass-card p-3 rounded-xl border border-slate-800">
                        <div class="text-[10px] uppercase font-bold text-slate-400">Date Recorded</div>
                        <div id="detailDate" class="text-xs font-semibold text-slate-200 mt-1">--</div>
                    </div>
                    <div class="glass-card p-3 rounded-xl border border-slate-800">
                        <div class="text-[10px] uppercase font-bold text-slate-400">Update Status</div>
                        <select id="detailStatusSelect" class="mt-1 w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-200 focus:outline-none focus:border-emerald-500">
                            <option value="Identified Sighting">Identified Sighting</option>
                            <option value="Under Watch">Under Watch</option>
                            <option value="Treated / Removed">Treated / Removed</option>
                        </select>
                    </div>
                </div>

                <!-- Observation Notes -->
                <div class="glass-card p-3.5 rounded-xl border border-slate-800">
                    <div class="text-[10px] uppercase font-bold text-slate-400 mb-1">Field Observation Notes</div>
                    <p id="detailNotes" class="text-xs text-slate-300 leading-relaxed italic">
                        No additional field notes provided for this site.
                    </p>
                </div>

                <!-- Action Footer Buttons -->
                <div class="pt-2 flex items-center justify-between gap-3">
                    <button id="deleteLocationBtn" class="px-4 py-2 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 border border-rose-500/30 text-xs font-semibold transition flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Delete Marker</span>
                    </button>

                    <button id="detailZoomBtn" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                        </svg>
                        <span>Fly To Marker</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: DELETE CONFIRMATION DIALOG (No alert/confirm) -->
    <div id="confirmDeleteOverlay" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-sm rounded-2xl p-6 border border-rose-500/40 text-center space-y-4 shadow-2xl animate-in fade-in zoom-in duration-150">
            <div class="w-12 h-12 rounded-2xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div>
                <h4 class="font-bold text-base text-white">Delete Sighting?</h4>
                <p class="text-xs text-slate-400 mt-1">This will permanently delete this location marker from the database for all users.</p>
            </div>
            <div class="flex items-center justify-center gap-3 pt-2">
                <button id="cancelDeleteBtn" class="w-1/2 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition">
                    Cancel
                </button>
                <button id="confirmDeleteBtn" class="w-1/2 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-lg shadow-rose-950/50 transition">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>

    <!-- TOAST NOTIFICATION SYSTEM CONTAINER -->
    <div id="toastContainer" class="fixed top-20 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- FIREBASE & APPLICATION LOGIC -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, onSnapshot, addDoc, updateDoc, deleteDoc, doc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // APP CONFIG & FIREBASE INITIALIZATION
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'multiflora-tracker-default';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-app.firebaseapp.com",
            projectId: "demo-app",
            storageBucket: "demo-app.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:demo"
        };
        const initialToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        // APPLICATION STATE
        let db = null;
        let auth = null;
        let currentUser = null;
        let map = null;
        let locations = [];
        let markersMap = {}; // id -> MapLibre marker instance
        let isPickMode = false;
        let selectedLocationId = null;
        let activeFilterText = '';

        // SEED DEMO DATA
        const DEMO_LOCATIONS = [
            {
                name: "Pine Ridge Nature Preserve",
                latitude: 41.5200,
                longitude: -72.8500,
                date: "2026-10-15",
                status: "Identified Sighting",
                notes: "Dense thorny thicket expanding along the western hiking trail margin."
            },
            {
                name: "Housatonic Riverbank Woods",
                latitude: 41.3200,
                longitude: -73.0800,
                date: "2026-10-28",
                status: "Under Watch",
                notes: "Scatterings observed near water edge. Growth monitored by local environmental volunteer group."
            },
            {
                name: "Norwalk Meadow Patch B",
                latitude: 41.1150,
                longitude: -73.4100,
                date: "2026-11-01",
                status: "Treated / Removed",
                notes: "Targeted mechanical eradication complete. Spot re-checked quarterly."
            },
            {
                name: "Mianus River Gorge Trail",
                latitude: 41.1600,
                longitude: -73.6000,
                date: "2026-11-02",
                status: "Identified Sighting",
                notes: "Large mature cluster interfering with native shrub species."
            }
        ];

        // UI TOAST NOTIFICATION HELPER
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');

            const colorClasses = type === 'success'
                ? 'border-emerald-500/40 text-emerald-200 bg-emerald-950/80'
                : type === 'error'
                ? 'border-rose-500/40 text-rose-200 bg-rose-950/80'
                : 'border-cyan-500/40 text-cyan-200 bg-slate-900/90';

            toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl glass-panel border shadow-2xl text-xs font-semibold flex items-center gap-2 animate-in slide-in-from-right duration-200 ${colorClasses}`;
            toast.innerHTML = `
                <span>${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'transition-opacity', 'duration-300');
                setTimeout(() => toast.remove(), 300);
            }, 3200);
        }

        // INITIALIZE MAPLIBRE MAP
        function initMap() {
            map = new maplibregl.Map({
                container: 'map',
                style: {
                    version: 8,
                    sources: {
                        'carto-dark': {
                            type: 'raster',
                            tiles: [
                                'https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png',
                                'https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png',
                                'https://c.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png'
                            ],
                            tileSize: 256,
                            attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
                        }
                    },
                    layers: [
                        {
                            id: 'carto-dark-layer',
                            type: 'raster',
                            source: 'carto-dark',
                            minzoom: 0,
                            maxzoom: 19
                        }
                    ]
                },
                center: [-72.8500, 41.5200],
                zoom: 8.5,
                pitch: 25
            });

            // Navigation Controls
            map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'bottom-right');

            // Handle Resize
            window.addEventListener('resize', () => map && map.resize());

            // Map Click Event for Pinning Mode & Dismissing
            map.on('click', (e) => {
                if (isPickMode) {
                    const lat = e.lngLat.lat.toFixed(6);
                    const lng = e.lngLat.lng.toFixed(6);

                    document.getElementById('formLat').value = lat;
                    document.getElementById('formLng').value = lng;

                    togglePickMode(false);
                    openAddModal();
                    showToast(`Coordinates picked: ${lat}, ${lng}`, 'success');
                }
            });
        }

        // CREATE CUSTOM MARKER HTML ELEMENT
        function createMarkerElement(loc) {
            const el = document.createElement('div');
            el.className = 'marker-pin-wrapper group';

            let colorHex = '#10b981'; // Emerald Identified
            let auraColor = 'rgba(16, 185, 129, 0.4)';
            let iconSymbol = '🌿';

            if (loc.status === 'Under Watch') {
                colorHex = '#f59e0b';
                auraColor = 'rgba(245, 158, 11, 0.4)';
                iconSymbol = '👁️';
            } else if (loc.status === 'Treated / Removed') {
                colorHex = '#06b6d4';
                auraColor = 'rgba(6, 182, 212, 0.4)';
                iconSymbol = '✂️';
            }

            el.innerHTML = `
                <div class="marker-pulse" style="background-color: ${auraColor}"></div>
                <div class="relative z-10 w-8 h-8 rounded-full bg-slate-900 border-2 shadow-xl flex items-center justify-center text-xs transition-transform duration-200 group-hover:scale-125" style="border-color: ${colorHex}">
                    <span>${iconSymbol}</span>
                </div>
                <!-- Hover Tooltip -->
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:flex flex-col items-center pointer-events-none z-30">
                    <div class="px-2.5 py-1 rounded-lg glass-panel border border-slate-700 text-[11px] font-bold text-white whitespace-nowrap shadow-xl">
                        ${loc.name || 'Multiflora Sighting'}
                    </div>
                </div>
            `;

            return el;
        }

        // RENDER / SYNC MARKERS ON MAP
        function renderMarkers() {
            // Filter locations based on search text
            const filtered = locations.filter(loc => {
                if (!activeFilterText) return true;
                const query = activeFilterText.toLowerCase();
                return (loc.name && loc.name.toLowerCase().includes(query)) ||
                       (loc.status && loc.status.toLowerCase().includes(query)) ||
                       (loc.notes && loc.notes.toLowerCase().includes(query)) ||
                       (loc.date && loc.date.includes(query));
            });

            // Track active IDs to remove deleted markers
            const currentIds = new Set(filtered.map(l => l.id));

            // Remove markers not in current view
            Object.keys(markersMap).forEach(id => {
                if (!currentIds.has(id)) {
                    markersMap[id].remove();
                    delete markersMap[id];
                }
            });

            // Add or update markers
            filtered.forEach(loc => {
                if (!loc.latitude || !loc.longitude) return;

                if (!markersMap[loc.id]) {
                    const el = createMarkerElement(loc);

                    el.addEventListener('click', (e) => {
                        e.stopPropagation();
                        openDetailModal(loc.id);
                    });

                    const marker = new maplibregl.Marker({ element: el })
                        .setLngLat([Number(loc.longitude), Number(loc.latitude)])
                        .addTo(map);

                    markersMap[loc.id] = marker;
                } else {
                    markersMap[loc.id].setLngLat([Number(loc.longitude), Number(loc.latitude)]);
                }
            });

            updateStatsAndDirectory(filtered);
        }

        // UPDATE DASHBOARD STATS & SIDE DRAWER LIST
        function updateStatsAndDirectory(filteredLocs) {
            // Stats
            document.getElementById('statTotalCount').innerText = locations.length;

            const watchCount = locations.filter(l => l.status === 'Under Watch').length;
            document.getElementById('statWatchCount').innerText = watchCount;

            const treatedCount = locations.filter(l => l.status === 'Treated / Removed').length;
            document.getElementById('statTreatedCount').innerText = treatedCount;

            document.getElementById('listBadgeCount').innerText = filteredLocs.length;
            document.getElementById('drawerVisibleCount').innerText = filteredLocs.length;

            // Directory Drawer Render
            const drawerContent = document.getElementById('drawerListContent');
            drawerContent.innerHTML = '';

            if (filteredLocs.length === 0) {
                drawerContent.innerHTML = `
                    <div class="py-12 text-center text-slate-500 text-xs">
                        No location records found matching your search.
                    </div>
                `;
                return;
            }

            filteredLocs.forEach(loc => {
                const card = document.createElement('div');
                card.className = "glass-card p-3 rounded-xl border border-slate-800 hover:border-slate-700 cursor-pointer transition flex items-center justify-between group";

                let badgeClass = 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';
                if (loc.status === 'Under Watch') badgeClass = 'bg-amber-500/20 text-amber-400 border-amber-500/30';
                if (loc.status === 'Treated / Removed') badgeClass = 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30';

                card.innerHTML = `
                    <div>
                        <h4 class="font-bold text-xs text-white group-hover:text-emerald-400 transition">${loc.name || 'Unnamed Spot'}</h4>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-[10px] font-mono text-slate-400">${Number(loc.latitude).toFixed(4)}, ${Number(loc.longitude).toFixed(4)}</span>
                            <span class="text-[9px] px-1.5 py-0.2 rounded-full font-semibold border ${badgeClass}">
                                ${loc.status || 'Identified'}
                            </span>
                        </div>
                    </div>
                    <button class="p-1.5 text-slate-500 group-hover:text-cyan-400 transition">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                `;

                card.addEventListener('click', () => {
                    flyToLocation(loc.longitude, loc.latitude);
                    openDetailModal(loc.id);
                });

                drawerContent.appendChild(card);
            });
        }

        // FLY TO MAP COORDINATE
        function flyToLocation(lng, lat) {
            if (!map) return;
            map.flyTo({
                center: [Number(lng), Number(lat)],
                zoom: 14,
                speed: 1.4,
                curve: 1
            });
        }

        // RESET MAP VIEW TO BOUNDS
        function resetMapView() {
            if (!map || locations.length === 0) {
                map.flyTo({ center: [-72.8500, 41.5200], zoom: 8.5 });
                return;
            }

            const bounds = new maplibregl.LngLatBounds();
            locations.forEach(loc => bounds.extend([Number(loc.longitude), Number(loc.latitude)]));
            map.fitBounds(bounds, { padding: 80, maxZoom: 14, duration: 1200 });
            showToast("Recentered view to fit all markers", "info");
        }

        // TOGGLE MAP PICK MODE
        function togglePickMode(enable) {
            isPickMode = enable !== undefined ? enable : !isPickMode;
            const banner = document.getElementById('pickingBanner');
            const body = document.body;

            if (isPickMode) {
                banner.classList.remove('hidden');
                body.classList.add('crosshair-cursor');
                showToast("Click map location to choose coordinates", "info");
            } else {
                banner.classList.add('hidden');
                body.classList.remove('crosshair-cursor');
            }
        }

        // MODAL MANAGEMENT
        function openAddModal() {
            document.getElementById('addModalOverlay').classList.remove('hidden');
            if (!document.getElementById('formDate').value) {
                document.getElementById('formDate').value = new Date().toISOString().split('T')[0];
            }
        }

        function closeAddModal() {
            document.getElementById('addModalOverlay').classList.add('hidden');
            document.getElementById('addLocationForm').reset();
        }

        function openDetailModal(id) {
            selectedLocationId = id;
            const loc = locations.find(l => l.id === id);
            if (!loc) return;

            document.getElementById('detailName').innerText = loc.name || 'Multiflora Sighting';
            document.getElementById('detailLat').innerText = Number(loc.latitude).toFixed(6);
            document.getElementById('detailLng').innerText = Number(loc.longitude).toFixed(6);
            document.getElementById('detailDate').innerText = loc.date || 'Not specified';
            document.getElementById('detailNotes').innerText = loc.notes || 'No field observation notes attached.';

            const badge = document.getElementById('detailBadge');
            badge.innerText = loc.status || 'Identified Sighting';

            const statusSelect = document.getElementById('detailStatusSelect');
            statusSelect.value = loc.status || 'Identified Sighting';

            document.getElementById('detailModalOverlay').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModalOverlay').classList.add('hidden');
            selectedLocationId = null;
        }

        // EXPORT TO CSV
        function exportToCSV() {
            if (locations.length === 0) {
                showToast("No locations available to export", "error");
                return;
            }

            let csv = 'Name,Latitude,Longitude,Date,Status,Notes\n';
            locations.forEach(loc => {
                const name = `"${(loc.name || '').replace(/"/g, '""')}"`;
                const notes = `"${(loc.notes || '').replace(/"/g, '""')}"`;
                csv += `${name},${loc.latitude},${loc.longitude},${loc.date || ''},"${loc.status || ''}",${notes}\n`;
            });

            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `multiflora_tracker_export_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Exported locations CSV", "success");
        }

        // FIREBASE FIRESTORE SYNC & SEEDING
        async function setupFirebase() {
            try {
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                // Auth Step (Mandatory Rule 3)
                if (initialToken) {
                    await signInWithCustomToken(auth, initialToken);
                } else {
                    await signInAnonymously(auth);
                }
                currentUser = auth.currentUser;

                // Listen to Realtime Collection (Mandatory Rule 1 & Rule 2)
                const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'locations');

                onSnapshot(colRef, (snapshot) => {
                    const loaded = [];
                    snapshot.forEach(docSnap => {
                        loaded.push({ id: docSnap.id, ...docSnap.data() });
                    });

                    locations = loaded;

                    // If collection is empty, auto seed demo locations on first launch
                    if (locations.length === 0) {
                        seedInitialLocations();
                    } else {
                        renderMarkers();
                    }
                }, (error) => {
                    console.error("Firestore subscription error:", error);
                    showToast("Database sync error: " + error.message, "error");
                });

            } catch (err) {
                console.warn("Firebase initialization failed, running in fallback mode:", err);
                document.getElementById('networkStatusBadge').innerHTML = `
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    LOCAL MODE
                `;
                locations = [...DEMO_LOCATIONS.map((d, i) => ({ id: 'demo-' + i, ...d }))];
                renderMarkers();
            }
        }

        // SEED DEMO LOCATIONS INTO FIRESTORE
        async function seedInitialLocations() {
            if (!db) return;
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'locations');
            try {
                for (const loc of DEMO_LOCATIONS) {
                    await addDoc(colRef, loc);
                }
                showToast("Loaded sample locations into realtime database", "success");
            } catch (e) {
                console.error("Error seeding initial locations:", e);
            }
        }

        // SAVE NEW LOCATION TO FIRESTORE
        async function saveLocation(formData) {
            if (db) {
                try {
                    const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'locations');
                    await addDoc(colRef, formData);
                    showToast("Sighting recorded to database!", "success");
                } catch (err) {
                    showToast("Failed to save: " + err.message, "error");
                }
            } else {
                // Fallback local state
                const newLoc = { id: 'local-' + Date.now(), ...formData };
                locations.push(newLoc);
                renderMarkers();
                showToast("Sighting added locally", "success");
            }
        }

        // UPDATE STATUS IN FIRESTORE
        async function updateLocationStatus(id, newStatus) {
            if (db) {
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'locations', id);
                    await updateDoc(docRef, { status: newStatus });
                    showToast("Status updated!", "success");
                } catch (err) {
                    showToast("Failed to update status", "error");
                }
            } else {
                const loc = locations.find(l => l.id === id);
                if (loc) {
                    loc.status = newStatus;
                    renderMarkers();
                }
            }
        }

        // DELETE LOCATION FROM FIRESTORE
        async function deleteLocation(id) {
            if (db) {
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'locations', id);
                    await deleteDoc(docRef);
                    showToast("Marker deleted from database", "success");
                } catch (err) {
                    showToast("Delete failed: " + err.message, "error");
                }
            } else {
                locations = locations.filter(l => l.id !== id);
                renderMarkers();
                showToast("Marker deleted", "success");
            }
        }

        // DOM EVENT LISTENERS ATTACHMENT
        window.addEventListener('DOMContentLoaded', () => {
            initMap();
            setupFirebase();

            // Search Filter Listener
            const searchInput = document.getElementById('searchInput');
            const clearSearchBtn = document.getElementById('clearSearchBtn');

            searchInput.addEventListener('input', (e) => {
                activeFilterText = e.target.value.trim();
                clearSearchBtn.classList.toggle('hidden', !activeFilterText);
                renderMarkers();
            });

            clearSearchBtn.addEventListener('click', () => {
                searchInput.value = '';
                activeFilterText = '';
                clearSearchBtn.classList.add('hidden');
                renderMarkers();
            });

            // Control Bar Buttons
            document.getElementById('openAddModalBtn').addEventListener('click', openAddModal);
            document.getElementById('closeAddModalBtn').addEventListener('click', closeAddModal);
            document.getElementById('cancelFormBtn').addEventListener('click', closeAddModal);

            document.getElementById('startPickMapBtn').addEventListener('click', () => togglePickMode());
            document.getElementById('cancelPickBtn').addEventListener('click', () => togglePickMode(false));
            document.getElementById('formPickMapBtn').addEventListener('click', () => {
                closeAddModal();
                togglePickMode(true);
            });

            // List Drawer Toggle
            const listDrawer = document.getElementById('listDrawer');
            document.getElementById('toggleListBtn').addEventListener('click', () => {
                listDrawer.classList.toggle('translate-x-[120%]');
            });
            document.getElementById('closeListBtn').addEventListener('click', () => {
                listDrawer.classList.add('translate-x-[120%]');
            });

            // Reset Map & Export
            document.getElementById('resetViewBtn').addEventListener('click', resetMapView);
            document.getElementById('exportCsvBtn').addEventListener('click', exportToCSV);
            document.getElementById('seedDataBtn').addEventListener('click', seedInitialLocations);

            // Add Location Form Handler
            document.getElementById('addLocationForm').addEventListener('submit', (e) => {
                e.preventDefault();
                const formData = {
                    name: document.getElementById('formName').value.trim(),
                    latitude: parseFloat(document.getElementById('formLat').value),
                    longitude: parseFloat(document.getElementById('formLng').value),
                    date: document.getElementById('formDate').value,
                    status: document.getElementById('formStatus').value,
                    notes: document.getElementById('formNotes').value.trim()
                };

                saveLocation(formData);
                closeAddModal();
            });

            // Geolocation GPS Helper
            document.getElementById('useGpsBtn').addEventListener('click', () => {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        (pos) => {
                            document.getElementById('formLat').value = pos.coords.latitude.toFixed(6);
                            document.getElementById('formLng').value = pos.coords.longitude.toFixed(6);
                            showToast("Captured GPS position", "success");
                        },
                        () => showToast("Unable to fetch current GPS location", "error")
                    );
                } else {
                    showToast("Geolocation is not supported by your browser", "error");
                }
            });

            // Detail Modal Controls
            document.getElementById('closeDetailModalBtn').addEventListener('click', closeDetailModal);

            document.getElementById('copyCoordsBtn').addEventListener('click', () => {
                const lat = document.getElementById('detailLat').innerText;
                const lng = document.getElementById('detailLng').innerText;
                const coordsStr = `${lat}, ${lng}`;

                // Fallback copy using textarea execCommand
                const ta = document.createElement('textarea');
                ta.value = coordsStr;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showToast("Coordinates copied to clipboard!", "success");
            });

            document.getElementById('detailZoomBtn').addEventListener('click', () => {
                if (!selectedLocationId) return;
                const loc = locations.find(l => l.id === selectedLocationId);
                if (loc) {
                    flyToLocation(loc.longitude, loc.latitude);
                    closeDetailModal();
                }
            });

            document.getElementById('detailStatusSelect').addEventListener('change', (e) => {
                if (selectedLocationId) {
                    updateLocationStatus(selectedLocationId, e.target.value);
                }
            });

            // Delete Dialog Controls (Replacing alert/confirm)
            const confirmOverlay = document.getElementById('confirmDeleteOverlay');
            document.getElementById('deleteLocationBtn').addEventListener('click', () => {
                confirmOverlay.classList.remove('hidden');
            });

            document.getElementById('cancelDeleteBtn').addEventListener('click', () => {
                confirmOverlay.classList.add('hidden');
            });

            document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
                if (selectedLocationId) {
                    deleteLocation(selectedLocationId);
                    confirmOverlay.classList.add('hidden');
                    closeDetailModal();
                }
            });
        });
    </script>
</body>
</html>
