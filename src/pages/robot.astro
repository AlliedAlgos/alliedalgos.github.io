---
import Layout from '../layouts/Layout.astro';
import RobotCard from '../components/robotCard.astro';
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';

const raw = readFileSync('./src/data/robots.toml', 'utf-8');
const { robots } = parse(raw);

// Logic: Reverse the array so the latest version is first
const chronologicalRobots = [...robots].reverse();

const title = "Our Robots | Allied Algorithms";
---

<Layout title={title}>
    <main class="font-mono relative min-h-screen overflow-hidden bg-[#60a5fa] text-white">

        <!-- Blueprint Grid Background Texture -->
        <div class="absolute inset-0 bg-blueprint-grid opacity-10 pointer-events-none z-0"></div>

        <section class="relative pt-32 pb-20 flex items-center justify-center text-center overflow-hidden z-10">
            <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
                <span class="font-mono text-blue-100 uppercase tracking-widest text-xs mb-4 block">Build Log &middot; MK1&ndash;MK{robots.length}</span>
                <h1 class="text-7xl md:text-9xl font-black tracking-tighter italic text-white leading-[0.8] mb-8 uppercase drop-shadow-md">
                    Robot <br><span class="text-blue-100/70">Evolution.</span>
                </h1>
                <p class="text-blue-50 text-sm md:text-base font-light max-w-xl mx-auto leading-relaxed">
                    A look at our engineering journey—from our early prototypes to the modular, high-precision systems we use today.
                </p>
            </div>
        </section>

        <section class="max-w-5xl mx-auto px-6 pb-40 relative z-10">
            <div class="flex flex-col gap-24">
                {chronologicalRobots.map((robot, index) => {
                    const mkNumber = chronologicalRobots.length - index;
                    return (
                        <div class="relative">
                            {index !== chronologicalRobots.length - 1 && (
                                <div class="absolute left-1/2 top-full w-px h-24 bg-white/20 -translate-x-1/2 hidden md:block"></div>
                            )}

                            <div class="relative bg-blue-900/50 border border-white/25 rounded-3xl p-6 md:p-8 transition-colors hover:border-white/50 backdrop-blur-md shadow-2xl">
                                <!-- Blueprint corner accents -->
                                <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-white/40"></span>
                                <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-white/40"></span>

                                <div class="absolute -top-3 left-8 z-20 bg-blue-950 border border-white/20 px-3 py-1 font-mono text-xs text-blue-200 uppercase tracking-widest rounded-lg shadow">
                                    MK{mkNumber} <span class="text-blue-400">/</span> {String(mkNumber).padStart(2, '0')} of {String(chronologicalRobots.length).padStart(2, '0')}
                                </div>

                                <RobotCard {...robot} />
                            </div>
                        </div>
                    );
                })}
            </div>
        </section>
    </main>
</Layout>
