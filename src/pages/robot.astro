---
import Layout from '../layouts/Layout.astro';
import RobotCard from '../components/robotCard.astro';
import { parse } from 'smol-toml';
import { readFileSync } from 'fs';

const raw = readFileSync('./src/data/robots.toml', 'utf-8');
const { robots } = parse(raw);

// Logic: Reverse the array so the latest version (V5) is first
const chronologicalRobots = [...robots].reverse();

const title = "Our Robots | Allied Algorithms";
---

<Layout title={title}>
    <section class="relative pt-32 pb-20 flex items-center justify-center text-center overflow-hidden">
        <div class="absolute inset-0 bg-blueprint-grid opacity-20 [mask-image:radial-gradient(circle_at_50%_20%,black,transparent_70%)] pointer-events-none"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
            <span class="font-mono text-blue-400 uppercase tracking-widest text-xs mb-4 block">Build Log &middot; MK1&ndash;MK5</span>
            <h1 class="text-7xl md:text-9xl font-black tracking-tighter italic text-white leading-[0.8] mb-8 uppercase">
                Robot <br><span class="text-accent">Evolution.</span>
            </h1>
            <p class="text-zinc-400 text-lg md:text-xl font-light max-w-2xl mx-auto leading-relaxed">
                A look at our engineering journey—from our early prototypes to the modular, high-precision systems we use today.
            </p>
        </div>
    </section>

    <section class="max-w-5xl mx-auto px-6 pb-40">
        <div class="flex flex-col gap-24">
            {chronologicalRobots.map((robot, index) => (
                <div class="relative">
                    {index !== chronologicalRobots.length - 1 && (
                        <div class="absolute left-1/2 top-full w-px h-24 bg-white/10 -translate-x-1/2 hidden md:block"></div>
                    )}

                    <div class="relative bg-zinc-900/30 border border-white/5 rounded-2xl p-4 transition-colors hover:border-blue-500/40">

                        <div class="absolute -top-3 left-8 z-20 bg-zinc-950 border border-white/10 px-3 py-1 font-mono text-xs text-blue-400 uppercase tracking-widest">
                            MK{chronologicalRobots.length - index} <span class="text-slate-600">/</span> {String(chronologicalRobots.length - index).padStart(2, '0')} of {String(chronologicalRobots.length).padStart(2, '0')}
                        </div>

                        <RobotCard {...robot} />
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
