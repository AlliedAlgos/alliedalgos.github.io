---
import Layout from '../layouts/Layout.astro';

const title = "Contact | Allied Algorithms Robotics";
const description = "Get in touch with Allied Algorithms FLL Team 600757. Reach out for technical collaborations, sponsorships, or general robotics inquiries.";
---

<Layout title={title} description={description}>

    <section class="relative pt-32 pb-16 overflow-hidden">
        <div class="absolute inset-0 bg-blueprint-grid opacity-30" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/0 via-blue-950/70 to-cyan-950/30" aria-hidden="true"></div>

        <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
            <p class="font-mono text-xs uppercase tracking-widest text-blue-400 mb-6">Team 600757 Comms</p>
            <h1 class="text-6xl md:text-8xl font-black tracking-tighter italic text-white leading-none mb-6 uppercase">
                GET IN <br /><span class="text-accent">TOUCH.</span>
            </h1>
            <p class="text-zinc-500 text-lg max-w-md mx-auto leading-relaxed">
                Questions about our robot, our code, or how to get involved? Here's how to reach the team directly.
            </p>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 mb-32">
        <div class="flex flex-col lg:flex-row gap-12 items-start">

            <div class="w-full lg:w-1/4 flex flex-col gap-3 lg:sticky lg:top-32">
                <p class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-2 ml-1">Direct Channels</p>

                <a href="https://github.com/AlliedAlgos" target="_blank" rel="noopener"
                   class="group flex items-center gap-4 px-5 py-4 border border-white/10 rounded-xl hover:border-blue-500/40 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                    <i class="fa-brands fa-github text-2xl text-zinc-500 group-hover:text-white transition-colors" aria-hidden="true"></i>
                    <div>
                        <span class="block font-mono text-[10px] uppercase tracking-widest text-zinc-500">Code Repository</span>
                        <span class="text-white font-medium">github.com/AlliedAlgos</span>
                    </div>
                </a>

                <a href="https://instagram.com/allied.algorithm" target="_blank" rel="noopener"
                   class="group flex items-center gap-4 px-5 py-4 border border-white/10 rounded-xl hover:border-blue-500/40 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                    <i class="fa-brands fa-instagram text-2xl text-zinc-500 group-hover:text-white transition-colors" aria-hidden="true"></i>
                    <div>
                        <span class="block font-mono text-[10px] uppercase tracking-widest text-zinc-500">Behind the Build</span>
                        <span class="text-white font-medium">@allied.algorithm</span>
                    </div>
                </a>

                <a href="mailto:alliedalgos@robolyst.org"
                   class="group flex items-center gap-4 px-5 py-4 border border-white/10 rounded-xl hover:border-blue-500/40 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400">
                    <i class="fa-solid fa-envelope text-2xl text-zinc-500 group-hover:text-white transition-colors" aria-hidden="true"></i>
                    <div>
                        <span class="block font-mono text-[10px] uppercase tracking-widest text-zinc-500">Direct Line</span>
                        <span class="text-white font-medium">alliedalgos@robolyst.org</span>
                    </div>
                </a>
            </div>

            <div class="w-full lg:w-3/4">
                <div class="relative bg-blue-400/60 border border-white/10 rounded-3xl p-4 md:p-8 overflow-hidden">
                    <span class="absolute -top-px -left-px w-4 h-4 border-t border-l border-blue-500/40" aria-hidden="true"></span>
                    <span class="absolute -bottom-px -right-px w-4 h-4 border-b border-r border-blue-500/40" aria-hidden="true"></span>

                    <iframe
                        src="https://robolyst.org/embed/form/form_d4hq0d28etvtp6e8ht7z?bg=transparent"
                        title="Contact"
                        style="width:100%;height:550px;border:0"
                    ></iframe>
                </div>
            </div>

        </div>
    </section>

</Layout>
